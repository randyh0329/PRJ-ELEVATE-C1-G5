# Dedicated container build for HR Policy RAG A2A Agent microservice
FROM python:3.13-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY config/ ./config/
COPY src/ ./src/
COPY okf/ ./okf/
COPY ["ALTOSTRAT SINGAPORE EMPLOYEE POLICY HANDBOOK & CONDUCT GUIDELINES.md", "./"]
COPY pyproject.toml .

# See the note in Dockerfile.orchestrator: an absent corpus is silent at
# runtime, so it is caught here instead. Offline and deterministic.
RUN python -c "\
from src.grounding.okf_store import okf_store; \
n = len(okf_store.all_policies()); \
print(f'policy corpus: {n} documents'); \
raise SystemExit(0 if n else 'FATAL: okf/ corpus missing or empty in image')"

ENV HF_HOME=/app/.cache/huggingface
# Hard-failing, unlike the orchestrator's copy of this line. The orchestrator can
# lose its index and still answer from the curated register; this service *is*
# the index, and the runtime auto-ingest that would rebuild it
# (src/grounding/policy_rag/service.py) takes ~48s with the model already on
# disk. `build_app` runs it before uvicorn binds the port, so the container
# never opens 8080 inside the startup-probe budget and the revision is rejected
# with ERROR_CONNECTION_FAILED - which reads as a crashed container rather than
# a slow one.
#
# A failed build is strictly better than that: it is visible, it names the real
# problem, and the layer cache makes the retry cheap.
RUN python -m src.grounding.policy_rag.cli ingest

# Ingest can succeed and still emit nothing if the corpus globs stop matching.
# An empty index serves confident silence: every retrieval returns no hits and
# the composer reports that the handbook covers nothing.
RUN python -c "\
from src.grounding.policy_rag.config import load_config; \
from src.grounding.policy_rag.index import PolicyIndex; \
idx = PolicyIndex.load(load_config().index.path); \
print(f'faiss index: {len(idx)} chunks'); \
raise SystemExit(0 if len(idx) else 'FATAL: index built but empty')"
ARG GIT_COMMIT_SHA=unknown
ENV GIT_COMMIT_SHA=${GIT_COMMIT_SHA}

RUN useradd -m -u 10001 appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/healthz || exit 1

CMD ["sh", "-c", "exec uvicorn src.grounding.policy_rag.a2a_app.server:build_app --factory --host 0.0.0.0 --port ${PORT}"]
