# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Origin Verification
AUTOMATION_ORIGIN_HEADER=HR_AGENT_ORCHESTRATOR_V1
DEFAULT_CALLER_ID=EMP-1001

# Guardrails Configuration
DEDUPLICATION_WINDOW_MINUTES=30
MAX_LEAVE_RETRIES=3
TOOL_TIMEOUT_SECONDS=4.0

# Future SaaS / RAG / A2A Credentials (Boilerplate)
WORKDAY_API_BASE_URL=https://api.workday.com/v40
SERVICENOW_API_BASE_URL=https://instance.service-now.com/api/now
VERTEX_SEARCH_DATASTORE_ID=projects/example/locations/global/collections/default_collection/dataStores/hr-handbook
